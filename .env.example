# Copie este arquivo para .env e ajuste. O .env NÃO vai para o Git.

# Provedor do modelo: ollama (local) ou groq (API)
PROVEDOR=ollama
MODELO=llama3.2

# Parâmetros de geração
TEMPERATURA=0.2
TOP_P=0.9
MAX_TOKENS=400

# Modelos comparados pelo avaliar_modelos.py (Ollama), separados por vírgula
MODELOS=llama3.2,llama3.1

# Só necessário se PROVEDOR=groq (nunca escreva a chave real no código)
GROQ_API_KEY=
